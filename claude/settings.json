{
  "model": "sonnet",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/Users/david/.claude/hooks/guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking guard rules..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/Users/david/.claude/hooks/after-edit.mjs"],
            "timeout": 150,
            "statusMessage": "Formatting and running related tests..."
          }
        ]
      }
    ]
  }
}
